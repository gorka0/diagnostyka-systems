# =============================================================================
# Diagnostyka-Systems s.c. - Konfiguracja Środowiska (Formularze & E-mail)
# =============================================================================
# Skopiuj ten plik do .env w środowisku produkcyjnym i uzupełnij dane SMTP.
# W trybie DEV (bez konfiguracji SMTP) maile są bezpiecznie rejestrowane
# w pliku server/logs/emails.log oraz wypisywane w konsoli serwera.

# Adres docelowy do odbioru zgłoszeń (zgodny z company.ts)
MAIL_TARGET_ADDRESS=poczta@beissbarth-service.pl

# Opcjonalne wysyłanie kopii potwierdzenia do klienta (domyślnie wyłączone)
SEND_CLIENT_CONFIRMATION=false

# Konfiguracja SMTP (wymagana na serwerze produkcyjnym)
SMTP_HOST=smtp.twoj-serwer-poczty.pl
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=poczta@beissbarth-service.pl
SMTP_PASS=twoje-tajne-haslo-smtp
SMTP_FROM="Diagnostyka-Systems Powiadomienia" <poczta@beissbarth-service.pl>

# Tryb developerski: true oznacza zapis do server/logs/emails.log
DEV_LOG_MAIL=true

# Port dla opcjonalnego samodzielnego serwera Node.js
PORT=3001
